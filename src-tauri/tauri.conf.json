{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caffeine",
  "version": "2.0.0",
  "identifier": "com.cnlutong.caffeine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caffeine",
        "width": 400,
        "height": 352,
        "minWidth": 360,
        "minHeight": 352,
        "resizable": false,
        "center": true,
        "create": false,
        "backgroundColor": "#f7f6f2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Keep your computer awake from the menu bar.",
    "longDescription": "Caffeine temporarily prevents idle system or display sleep. Runs as the current user without changing your power settings.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
